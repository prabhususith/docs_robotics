# RoboCore Studio — Environment Configuration
# Hardware Target: Lenovo ThinkBook (8GB RAM / 128GB SSD)

# Platform Execution Mode
NODE_ENV=development
DEFAULT_LOCALE=en
PORT_UI=5173
PORT_GATEWAY=5000
PORT_PYTHON_AI=8000
PORT_NGINX=8080

# Database Mode: 'sqlite' (local-first default, zero overhead) | 'postgres' (cloud pgvector)
DB_MODE=sqlite
SQLITE_DB_PATH=./data/robocore.sqlite
DATABASE_URL=postgresql://robocore_user:robocore_secret@localhost:5432/robocore_db

# LLM & Physical AI Provider: 'offline' (rule-based local fallback) | 'gemini' | 'openai' | 'azure_openai'
LLM_PROVIDER=offline
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# Inter-Process Communication (IPC) Bridge
PYTHON_AI_URL=http://localhost:8000
NODE_GATEWAY_URL=http://localhost:5000
WS_TELEMETRY_URL=ws://localhost:5000/ws
IPC_TIMEOUT_MS=1500
CIRCUIT_BREAKER_THRESHOLD=3

# Physics & Control Loop Rate (Hz)
SIM_PHYSICS_HERTZ=50
LIDAR_SAMPLE_RATE_HERTZ=10
SAFETY_ENVELOPE_STRICT=true
