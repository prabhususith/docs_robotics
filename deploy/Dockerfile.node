# =========================================================================
# RoboCore Studio — Node.js Express Gateway & ROS 2 Broker
# Hardware Envelope: ThinkBook 8GB RAM (< 220MB RAM Footprint)
# =========================================================================

# Stage 1: Build TypeScript contracts & Express core
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package descriptors
COPY package*.json tsconfig.base.json ./
COPY shared_bridge/package*.json ./shared_bridge/
COPY shared_bridge/tsconfig*.json ./shared_bridge/
COPY node_express_core/package*.json ./node_express_core/
COPY node_express_core/tsconfig*.json ./node_express_core/

# Install dependencies
RUN npm ci

# Copy sources
COPY shared_bridge/ ./shared_bridge/
COPY node_express_core/ ./node_express_core/

# Build shared bridge and node core
RUN npm run build:bridge
RUN npm run build:node

# Stage 2: Minimal Non-Root Production Runtime
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT_GATEWAY=5000

# Install production dependencies only
COPY package*.json tsconfig.base.json ./
COPY shared_bridge/package*.json ./shared_bridge/
COPY node_express_core/package*.json ./node_express_core/

RUN npm ci --omit=dev

# Copy compiled artifacts from builder
COPY --from=builder /app/shared_bridge/dist ./shared_bridge/dist
COPY --from=builder /app/shared_bridge/schemas ./shared_bridge/schemas
COPY --from=builder /app/node_express_core/dist ./node_express_core/dist

# Non-root user for security compliance
USER node

EXPOSE 5000

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/health || exit 1

CMD ["node", "node_express_core/dist/server.js"]
